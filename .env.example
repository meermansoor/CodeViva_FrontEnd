# Base URL of the Express backend. No trailing slash.
# Leave empty only if the frontend and backend are served from the same origin.
VITE_BACKEND_URL=http://localhost:5000

# Only needed if the frontend calls the FastAPI RAG service directly.
# Preferred long-term: route through Express and leave this unset.
# VITE_RAG_URL=http://localhost:8000

# Comma-separated STUN servers for WebRTC
VITE_STUN_URLS=stun:stun.l.google.com:19302
